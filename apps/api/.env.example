# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Auth
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
WEB_APP_URL=http://localhost:3001

# App
APP_NAME=MyApp

# Sarvam voice agent
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_ORG_ID=your-sarvam-org-id
SARVAM_WORKSPACE_ID=your-sarvam-workspace-id
SARVAM_VOICE_AGENT_ID=your-sarvam-agent-id
# SARVAM_TEXT_MODEL=sarvam-105b
# SARVAM_TRANSLATE_MODEL=sarvam-translate:v1

# OAuth (optional — uncomment to enable)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
