{
  "name": "api",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsx src/generate-openapi.ts && tsc",
    "start": "node dist/index.js",
    "generate-spec": "tsx src/generate-openapi.ts",
    "lint": "eslint src/",
    "pretest": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.9.10",
    "better-auth": "^1.6.9",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "express-zod-api": "^28.0.0",
    "http-errors": "^2.0.1",
    "pg": "^8.16.0",
    "sarvamai": "^1.1.8",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@vitest/coverage-v8": "^4.0.14",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.14"
  }
}
