{
  "name": "monorepo-template",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "bun install && turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate --filter=api",
    "db:migrate": "turbo run db:migrate --filter=api",
    "db:studio": "turbo run db:studio --filter=api",
    "generate-spec": "turbo run generate-spec --filter=api",
    "generate-client": "turbo run generate-client --filter=@repo/api-client"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "packageManager": "bun@1.3.5"
}
